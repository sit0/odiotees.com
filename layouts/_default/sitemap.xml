{{/*
  Własny szablon sitemapy. Domyślna sitemapa Hugo NIE zawiera znaczników
  <xhtml:link rel="alternate" hreflang="...">, a Google zaleca je właśnie
  w sitemapie przy serwisach wielojęzycznych. Ten szablon dokłada je
  automatycznie na podstawie .AllTranslations — nie trzeba nic ręcznie
  dopisywać przy dodaniu kolejnego języka.
*/}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
  {{- if .Permalink }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}"/>
    {{- end }}
    {{- range .AllTranslations }}
    {{- if eq .Language.Lang $.Site.Params.defaultLang }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ .Permalink }}"/>
    {{- end }}
    {{- end }}
    {{- end }}
  </url>
  {{- end }}
  {{ end }}
</urlset>
