# ODIO TEES — opcjonalny plik dla hostingu na Apache (własna domena).
# ------------------------------------------------------------------
# UWAGA: GitHub Pages NIE obsługuje .htaccess / mod_rewrite — na
# podglądzie (*.github.io) ten plik jest po prostu ignorowany.
# Ma sens dopiero po skopiowaniu zawartości public/ na serwer Apache
# (własna domena, docelowy hosting).
# ------------------------------------------------------------------
# Struktura katalogów wygenerowana przez Hugo:
#   /            -> polska wersja (domyślna)
#   /en/         -> wersja angielska
#   /de/         -> wersja niemiecka
# ------------------------------------------------------------------

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Automatyczne przekierowanie NOWYCH odwiedzających ze strony głównej
  # na wersję językową zgodną z przeglądarką (Accept-Language).
  # Działa tylko raz — każda strona ustawia ciasteczko "odio_lang" w JS
  # (patrz layouts/partials/scripts.html), więc kolejne wizyty na "/"
  # nie są już przekierowywane.

  RewriteCond %{HTTP_COOKIE} !odio_lang= [NC]
  RewriteCond %{REQUEST_URI} ^/$
  RewriteCond %{HTTP:Accept-Language} ^de [NC]
  RewriteRule ^$ /de/ [R=302,L]

  RewriteCond %{HTTP_COOKIE} !odio_lang= [NC]
  RewriteCond %{REQUEST_URI} ^/$
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [R=302,L]
</IfModule>

# ------------------------------------------------------------------
# Podstawowa wydajność (opcjonalne, bezpieczne domyślne ustawienia)
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

AddDefaultCharset UTF-8
